# VigilanceAI — Variables d'environnement
# Copier ce fichier en .env et remplir les clés

# OpenCage Geocoding API (gratuit 2500 req/jour)
# Créer un compte sur : https://opencagedata.com/
OPENCAGE_KEY=votre_cle_ici

# What3Words API (gratuit)
# Créer un compte sur : https://developer.what3words.com/
W3W_KEY=votre_cle_ici

# Position de la caméra (optionnel, auto-détectée par IP si absent)
CAMERA_LAT=
CAMERA_LON=
CAMERA_ALT=8.0
CAMERA_FOV_H=70.0
CAMERA_FOV_V=45.0
CAMERA_TILT=45.0
